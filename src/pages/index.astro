---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import Threshold from '../components/accueil/Threshold.astro';
import TrailSection from '../components/parcours/TrailSection.astro';
import ProjectSection from '../components/projet/ProjectSection.astro';
import EpicHero from '../islands/accueil/EpicHero';
import WelcomeModal from '../islands/accueil/WelcomeModal';
import MaintenancePage from '../components/site/MaintenancePage.astro';
import { config, enMaintenance } from '../lib/config';

const { site, accueil, projet } = config;
const bienvenueActive = accueil?.bienvenue && accueil.bienvenue.actif !== false;
---

{
  enMaintenance() ? (
    <MaintenancePage />
  ) : (
    <BaseLayout chemin="/" image={accueil?.heroImages?.front}>
      <Header href="#epic" />

      <main>
        <section id="epic" class="relative">
          <EpicHero
            client:load
            images={accueil?.heroImages ?? {}}
            eyebrow={site.eyebrow}
            nom={site.nomCourt ?? site.nom}
            tagline={site.tagline}
            badge={site.badge}
          />
        </section>

        {/* Remonte sous la fin du hero : le tracé démarre pendant que le dernier tableau s'efface. */}
        {accueil?.seuil && <Threshold class="-mt-[50svh]" phrase={accueil.seuil} image={accueil.imageSeuil} />}

        <TrailSection />

        {projet && <ProjectSection projet={projet} />}
      </main>

      <Footer brandHref="#epic" />

      {bienvenueActive && <WelcomeModal client:load bienvenue={accueil.bienvenue!} />}
    </BaseLayout>
  )
}
