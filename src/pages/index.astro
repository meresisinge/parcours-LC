---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import Seuil from '../components/accueil/Seuil.astro';
import ParcoursSection from '../components/parcours/ParcoursSection.astro';
import ProjetSection from '../components/projet/ProjetSection.astro';
import EpicHero from '../islands/accueil/EpicHero';
import WelcomeModal from '../islands/accueil/WelcomeModal';
import { config } from '../lib/config';

const { site, accueil, projet } = config;
---

<BaseLayout chemin="/" image={accueil?.heroImages?.front}>
  <Header href="#epic" />

  <main>
    <section id="epic" class="relative">
      <EpicHero
        client:load
        images={accueil?.heroImages ?? {}}
        eyebrow={site.eyebrow}
        nom={site.nomCourt ?? site.nom}
        tagline={site.tagline}
        badge={site.badge}
      />
    </section>

    {accueil?.seuil && <Seuil phrase={accueil.seuil} image={accueil.imageSeuil} />}

    <ParcoursSection />

    {projet && <ProjetSection projet={projet} />}
  </main>

  <Footer brandHref="#epic" />

  {accueil?.bienvenue && <WelcomeModal client:load bienvenue={accueil.bienvenue} />}
</BaseLayout>
