---
import type { ChronologieItem } from '../../types/parcours';

interface Props {
  items: ChronologieItem[];
  titre?: string;
}
const { items, titre = 'Repères' } = Astro.props;
---

{
  items.length > 0 && (
    <section class="mt-13" aria-label={titre}>
      <h3 class="mb-5 text-xs font-bold tracking-[0.08em] text-grey uppercase">{titre}</h3>
      <ol class="timeline m-0 list-none p-0">
        {items.map((item) => (
          <li class="timeline-item">
            <span class="timeline-dot" aria-hidden="true" />
            <div class="font-display text-[17px] leading-none font-extrabold text-blue-deep">
              {item.annee}
            </div>
            <div class="mt-1.5 text-[14.5px] leading-snug font-bold text-navy">{item.titre}</div>
            {item.texte && <p class="mt-1.5 text-[13.5px] leading-relaxed text-ink">{item.texte}</p>}
          </li>
        ))}
      </ol>
    </section>
  )
}
