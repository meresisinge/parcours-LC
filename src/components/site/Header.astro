---
import Brand from './Brand.astro';

interface Props {
  /** Ancre ou URL de la marque : `/` sur une page épisode, `#epic` sur l'accueil. */
  href?: string;
}
const { href = '/' } = Astro.props;
---

<header
  id="siteHeader"
  class="fixed inset-x-0 top-0 z-40 border-b border-transparent py-4 sm:py-5"
>
  <div
    class="shell-x mx-auto flex max-w-shell flex-wrap items-center justify-center gap-2.5 text-center sm:justify-between sm:text-left"
  >
    <Brand href={href} />
  </div>
</header>

<script>
  const header = document.getElementById('siteHeader');

  const sync = () => header?.classList.toggle('is-solid', window.scrollY > 60);
  sync();
  window.addEventListener('scroll', sync, { passive: true });
</script>

<style>
  #siteHeader.is-solid {
    background: rgb(253 253 251 / 0.92);
    backdrop-filter: blur(8px);
    border-color: var(--color-line);
  }
</style>
