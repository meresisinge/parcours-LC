---
import Brand from './Brand.astro';
import LegalModal from '../../islands/site/LegalModal';
import { config } from '../../lib/config';

interface Props {
  brandHref?: string;
}
const { brandHref = '/' } = Astro.props;
const { site, mentions } = config;
---

<footer class="border-t border-line px-5 py-7 sm:px-10 sm:py-11">
  <div class="mx-auto flex max-w-[1240px] flex-wrap items-center justify-between gap-4.5">
    <div class="flex flex-wrap items-center gap-4">
      <Brand href={brandHref} />
      {
        site.badge && (
          <span class="rounded-full border border-line px-3 py-1.5 text-[11px] font-bold tracking-[0.02em] text-grey">
            {site.badge.split('·')[0]!.trim()}
          </span>
        )
      }
    </div>

    {
      mentions?.sections?.length && (
        <nav class="flex gap-6">
          <LegalModal
            client:idle
            titre={mentions.titre ?? 'Mentions légales'}
            sections={mentions.sections}
            declencheurLabel={mentions.titre ?? 'Mentions légales'}
          />
        </nav>
      )
    }

    {site.credits && <div class="text-xs font-semibold text-grey">{site.credits}</div>}
  </div>
</footer>
