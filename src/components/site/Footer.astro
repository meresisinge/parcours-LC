---
import Brand from './Brand.astro';
import { config } from '../../lib/config';

interface Props {
  brandHref?: string;
}
const { brandHref = '/' } = Astro.props;
const { site, mentions } = config;
const mentionsLabel = mentions?.titre ?? 'Mentions légales';
---

<footer class="border-t border-line py-7 sm:py-11">
  <div class="shell-x mx-auto flex max-w-shell flex-col items-start gap-4 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between sm:gap-4.5">
    <div class="flex flex-wrap items-center gap-4">
      <Brand href={brandHref} />
      {
        site.badge && (
          <span class="rounded-full border border-line px-3 py-1.5 text-[11px] font-bold tracking-[0.02em] text-grey">
            {site.badge.split('·')[0]!.trim()}
          </span>
        )
      }
    </div>

    {
      mentions?.sections?.length && (
        <nav class="flex gap-6">
          <a
            href="/mentions-legales"
            class="text-xs font-semibold text-grey no-underline hover:text-navy"
          >
            {mentionsLabel}
          </a>
        </nav>
      )
    }

    {site.credits && <div class="text-xs font-semibold text-grey">{site.credits}</div>}
  </div>
</footer>
