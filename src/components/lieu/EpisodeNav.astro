---
import type { Lieu } from '../../types/parcours';
import { lieuPath } from '../../lib/urls';

interface Props {
  precedent: Lieu;
  suivant: Lieu;
}
const { precedent, suivant } = Astro.props;
---

<nav class="mt-13 border-t border-line pt-6" aria-label="Navigation entre les épisodes">
  <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-2 sm:gap-4">
    <a
      href={lieuPath(precedent.slug)}
      rel="prev"
      class="flex items-center gap-3 rounded-xl border border-line bg-white px-4 py-3.5 no-underline transition-colors duration-200 hover:border-blue-deep"
    >
      <span class="text-[15px] font-bold text-blue-bright" aria-hidden="true">←</span>
      <span class="min-w-0">
        <span class="block text-[10.5px] font-bold tracking-[0.1em] text-grey uppercase">
          Épisode précédent
        </span>
        <span class="block truncate text-[14px] font-bold text-navy">{precedent.titre}</span>
      </span>
    </a>

    <a
      href={lieuPath(suivant.slug)}
      rel="next"
      class="flex items-center justify-end gap-3 rounded-xl border border-line bg-white px-4 py-3.5 text-right no-underline transition-colors duration-200 hover:border-blue-deep"
    >
      <span class="min-w-0">
        <span class="block text-[10.5px] font-bold tracking-[0.1em] text-grey uppercase">
          Épisode suivant
        </span>
        <span class="block truncate text-[14px] font-bold text-navy">{suivant.titre}</span>
      </span>
      <span class="text-[15px] font-bold text-blue-bright" aria-hidden="true">→</span>
    </a>
  </div>

  <a
    href="/#parcours"
    class="mt-4 block text-center text-[13px] font-bold text-grey no-underline sm:mt-5"
  >
    Retour au parcours
  </a>
</nav>
