---
import type { Lieu } from '../../types/parcours';
import { lieuPath } from '../../lib/urls';

interface Props {
  precedent: Lieu;
  suivant: Lieu;
}
const { precedent, suivant } = Astro.props;
---

<nav
  class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 pt-10 text-[13px] font-bold text-blue-bright"
  aria-label="Navigation entre les épisodes"
>
  <a href={lieuPath(precedent.slug)} class="no-underline" rel="prev">← {precedent.titre}</a>
  <a href="/#parcours" class="font-semibold text-grey no-underline">Retour au parcours</a>
  <a href={lieuPath(suivant.slug)} class="no-underline" rel="next">{suivant.titre} →</a>
</nav>
