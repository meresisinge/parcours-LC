---
import type { Lieu } from '../../types/parcours';

interface Props {
  lieu: Lieu;
  eyebrow: string;
}
const { lieu, eyebrow } = Astro.props;
---

<figure
  class="relative m-0 aspect-[4/3] w-full overflow-hidden bg-paper sm:aspect-[3/2] min-[42rem]:rounded-2xl wide:aspect-[16/9]"
>
  <img
    src={lieu.image.hero}
    alt={lieu.image.alt ?? lieu.titre}
    class="h-full w-full object-cover"
    fetchpriority="high"
  />

  <!-- Voile haut : garde la marque du header fixe lisible au-dessus de l'image. -->
  <div
    class="absolute inset-x-0 top-0 h-20 bg-gradient-to-b from-paper/85 to-transparent"
    aria-hidden="true"
  >
  </div>

  <!-- Dégradé bas : porte le numéro d'épisode sans masquer l'illustration. -->
  <div
    class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-navy/75 to-transparent"
    aria-hidden="true"
  >
  </div>

  <figcaption
    class="absolute bottom-3.5 left-4 flex items-center gap-2 text-[11.5px] font-extrabold tracking-[0.12em] text-white uppercase sm:bottom-5 sm:left-6"
  >
    <span class="h-[3px] w-6 bg-red" aria-hidden="true"></span>
    {eyebrow}
  </figcaption>
</figure>
