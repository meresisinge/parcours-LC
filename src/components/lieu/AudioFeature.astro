---
/**
 * Bloc d'écoute : cœur de l'épisode. Carte surélevée qui porte le lecteur
 * (slot `player`) et l'accès au texte du récit (slot `recit`).
 */
interface Props {
  titre: string;
  dureeLabel?: string;
  indisponible?: boolean;
}
const { titre, dureeLabel, indisponible = false } = Astro.props;
---

<section
  class="relative overflow-hidden rounded-2xl border border-line bg-white px-5 pt-5 pb-5 shadow-[0_14px_38px_rgba(10,31,68,0.08)] sm:px-7 sm:pt-6 sm:pb-6"
  aria-labelledby="audioTitre"
>
  <span class="absolute inset-x-0 top-0 h-[3px] bg-red" aria-hidden="true"></span>

  <div class="mb-5 flex items-start justify-between gap-4">
    <div class="min-w-0">
      <div class="mb-1 text-[11px] font-extrabold tracking-[0.12em] text-red uppercase">
        Récit sonore
      </div>
      <h2 id="audioTitre" class="text-[19px] leading-tight font-black text-navy sm:text-[21px]">
        {titre}
      </h2>
    </div>

    {
      dureeLabel && (
        <span class="flex shrink-0 items-center gap-1.5 rounded-full bg-mist px-3 py-1.5 text-[11.5px] font-bold text-navy">
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 3" />
          </svg>
          {dureeLabel}
        </span>
      )
    }
  </div>

  <slot name="player" />

  {
    indisponible && (
      <p class="mt-3.5 text-[12.5px] font-semibold text-grey">
        L'enregistrement de cet épisode arrive bientôt — le texte du récit est déjà disponible.
      </p>
    )
  }

  <div class="mt-5 border-t border-line pt-4.5">
    <slot name="recit" />
  </div>
</section>
