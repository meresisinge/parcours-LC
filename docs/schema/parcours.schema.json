{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lieux-communs.local/schemas/parcours.schema.json",
  "title": "ParcoursConfig",
  "description": "Configuration locale du site Lieux communs (Astro / Cloudflare Pages).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "site", "lieux"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Version du format de configuration."
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nom", "langue", "tagline", "descriptionSeo"],
      "properties": {
        "nom": { "type": "string", "minLength": 1 },
        "nomCourt": { "type": "string" },
        "langue": { "type": "string", "minLength": 2 },
        "tagline": { "type": "string" },
        "eyebrow": { "type": "string" },
        "badge": { "type": "string" },
        "descriptionSeo": { "type": "string" },
        "urlCanonique": { "type": "string", "format": "uri" },
        "mediaBase": {
          "type": "string",
          "format": "uri",
          "description": "Base CDN des médias distants (audios .wav, images de galerie)."
        },
        "credits": { "type": "string" },
        "contact": { "type": "string" },
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bleuProfond": { "type": "string" },
            "bleuVif": { "type": "string" },
            "navy": { "type": "string" },
            "rouge": { "type": "string" },
            "papier": { "type": "string" }
          }
        }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actif"],
      "description": "Mode maintenance : quand actif, toutes les routes affichent la page d'attente (non indexée).",
      "properties": {
        "actif": { "type": "boolean" },
        "eyebrow": { "type": "string" },
        "titre": { "type": "string" },
        "titreAccent": { "type": "string" },
        "message": { "type": "string" },
        "signature": { "type": "string" }
      }
    },
    "accueil": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seuil": { "type": "string" },
        "imageSeuil": { "type": "string" },
        "heroImages": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "back": { "type": "string" },
            "mid": { "type": "string" },
            "front": { "type": "string" }
          }
        },
        "bienvenue": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "titre": { "type": "string" },
            "texte": { "type": "string" },
            "badge": { "type": "string" },
            "ctaLabel": { "type": "string" },
            "audio": { "$ref": "#/$defs/AudioRef" }
          }
        }
      }
    },
    "projet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eyebrow": { "type": "string" },
        "titre": { "type": "string" },
        "paragraphes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "image": { "type": "string" }
      }
    },
    "diorama": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string" },
        "imageNeutre": { "type": "string" },
        "alt": { "type": "string" }
      }
    },
    "lieux": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Lieu" }
    },
    "chronologieGlobale": {
      "type": "array",
      "items": { "$ref": "#/$defs/ChronologieItem" }
    },
    "mentions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "titre": { "type": "string" },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["titre", "paragraphes"],
            "properties": {
              "titre": { "type": "string" },
              "paragraphes": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "AudioRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src"],
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "duree": { "type": "number", "minimum": 0 },
        "titre": { "type": "string" },
        "version": { "type": "string" },
        "transcript": { "type": "string" }
      }
    },
    "ChronologieItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annee", "titre"],
      "properties": {
        "annee": { "type": "string" },
        "titre": { "type": "string" },
        "texte": { "type": "string" },
        "image": { "type": "string" },
        "lieuId": { "type": "string" }
      }
    },
    "MediaItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["image", "document", "carte", "lien"]
        },
        "tag": { "type": "string" },
        "label": { "type": "string" },
        "src": { "type": "string" },
        "url": { "type": "string" },
        "alt": { "type": "string" },
        "credit": { "type": "string" }
      }
    },
    "Lieu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "ordre", "titre", "accroche", "recit", "image"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "ordre": { "type": "integer", "minimum": 1 },
        "actif": { "type": "boolean", "default": true },
        "titre": { "type": "string", "minLength": 1 },
        "icone": { "type": "string" },
        "accroche": { "type": "string" },
        "recit": { "type": "string" },
        "dureeLabel": { "type": "string" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hero"],
          "properties": {
            "hero": { "type": "string" },
            "miniature": { "type": "string" },
            "alt": { "type": "string" }
          }
        },
        "audio": { "$ref": "#/$defs/AudioRef" },
        "diorama": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 },
            "zoom": { "type": "number", "minimum": 1 }
          }
        },
        "chronologie": {
          "type": "array",
          "items": { "$ref": "#/$defs/ChronologieItem" }
        },
        "medias": {
          "type": "array",
          "items": { "$ref": "#/$defs/MediaItem" }
        },
        "qr": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "labelImpression": { "type": "string" },
            "note": { "type": "string" }
          }
        }
      }
    }
  }
}
